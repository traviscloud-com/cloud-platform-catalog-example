# Terragrunt / Terraform
.terragrunt-cache/
.terragrunt-stack/
.terragrunt-stack-manifest
**/.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.fixture-state/
# Generated by `terragrunt stack generate` when run against the fixture in place
test/fixtures/**/terragrunt.values.hcl
test/fixtures/**/local-cluster/terragrunt.hcl
test/fixtures/**/keyvault/terragrunt.hcl
test/fixtures/region/live/dev/westus3/*/terragrunt.hcl
# ...but the region fixture's keyvault is a hand-written dependency stub.
!test/fixtures/region/live/dev/keyvault/terragrunt.hcl
debug.tfvars

# Local environment - NEVER commit secrets, state or real tfvars
.env
*.tfvars
!*.example.tfvars

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
